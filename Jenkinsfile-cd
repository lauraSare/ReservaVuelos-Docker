pipeline {
    agent any
    stages {
        stage('Checkout') {
            steps { checkout scm }
        }
        stage('Construir imagenes') {
            steps { bat 'docker compose -p reservavuelos build' }
        }
        stage('Desplegar') {
            steps {
                bat 'docker compose -p reservavuelos up -d'
            }
        }
        stage('Verificar despliegue') {
            steps {
                bat 'docker compose -p reservavuelos ps'
                retry(6) {
                    sleep time: 5, unit: 'SECONDS'
                    bat 'curl.exe -f -s -o NUL http://localhost:8088'
                    bat 'curl.exe -s -o NUL http://localhost:3000'
                }
            }
        }
    }
    post {
        success {
            slackSend(color: 'good', message: "Despliegue exitoso: ${env.JOB_NAME} #${env.BUILD_NUMBER} (${env.BUILD_URL})")
        }
        failure {
            slackSend(color: 'danger', message: "Despliegue fallido: ${env.JOB_NAME} #${env.BUILD_NUMBER} (${env.BUILD_URL})")
            bat 'docker compose -p reservavuelos logs --tail 40'
        }
    }
}